CREDITFLOW_API_URL=http://127.0.0.1:18081
# Production requires at least 32 random characters and HTTPS backend.
CREDITFLOW_SESSION_SECRET=replace-with-unique-project-secret
# Set only for a loopback-only local production build, never in a cloud release.
CREDITFLOW_LOCAL_DEMO=true
# Must match the isolated backend; never expose as NEXT_PUBLIC_*.
CREDITFLOW_PROVISION_KEY=
